#version 330 core
// ============================================================================
// ФРАГМЕНТНЫЙ ШЕЙДЕР ЧАСТИЦ (particles.frag)
// Закрашивает каждую каплю дождя, снежинку или линию скорости цветом биома
// с альфа-прозрачностью 0.85 (в C++ включено аддитивное смешивание GL_ONE).
// ============================================================================
out vec4 FragColor;

uniform vec3 color; // цвет осадков/скоростных полос для текущего биома

void main()
{
    FragColor = vec4(color, 0.85);
}
