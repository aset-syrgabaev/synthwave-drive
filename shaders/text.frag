#version 330 core
// ============================================================================
// ФРАГМЕНТНЫЙ ШЕЙДЕР 2D-ИНТЕРФЕЙСА HUD (text.frag) — критерии R5, R7, C3
// Читает одноканальную текстуру-атлас GL_R8 (128x48 пикселей, шрифт 5x7).
// Белые пиксели буквы имеют r = 1.0, фон r = 0.0 — умножаем на альфу цвета.
// ============================================================================
in vec2 UV;      // координаты пикселя внутри атласа шрифта
in vec4 Color;   // цвет текста или плашки HUD (RGBA)
out vec4 FragColor;

uniform sampler2D atlas; // процедурно сгенерированный в TextRenderer.h атлас GL_R8

void main()
{
    float a = texture(atlas, UV).r;
    FragColor = vec4(Color.rgb, Color.a * a);
}
