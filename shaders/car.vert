#version 330 core
// ============================================================================
// ВЕРШИННЫЙ ШЕЙДЕР 3D-ОБЪЕКТОВ (car.vert) — отвечает за критерии R1 и R3 (MVP)
// Вызывается видеокартой 1 раз для КАЖДОЙ вершины DeLorean, мотоцикла Акиры,
// поездов, эстакад ЛРТ, барьеров, монет и дронов.
// Главная задача: перевести 3D-точку из локальной системы модели на экран (gl_Position).
// ============================================================================
layout (location = 0) in vec3 aPos;    // входной атрибут 0 из VBO: локальные координаты вершины (x, y, z)
layout (location = 1) in vec3 aNormal; // входной атрибут 1 из VBO: вектор нормали (куда «смотрит» грань)

// Матрицы трансформации R3 (приходят из C++ через Shader::setMat4):
uniform mat4 model;      // M: перенос, поворот и масштаб конкретного объекта в мире
uniform mat4 view;       // V: матрица камеры (glm::lookAt), переводит мир в координаты глаз камеры
uniform mat4 projection; // P: перспективная проекция (glm::perspective), делает дальние объекты меньше

// Выходные переменные (видеокарта автоматически интерполирует их по всем пикселям треугольника):
out vec3 FragPos;  // позиция точки в мировых координатах (нужна в car.frag для расчёта лучей света и фар)
out vec3 Normal;   // нормаль поверхности в мировых координатах (нужна для скалярного произведения N·L)
out vec3 LocalPos; // исходная координата внутри модели (нужна для процедурных узоров скинов и щита)

void main()
{
    LocalPos = aPos;
    // Переводим локальную вершину в мировые координаты: M * (x, y, z, 1)
    FragPos = vec3(model * vec4(aPos, 1.0));
    // ВАЖНО ДЛЯ ЗАЩИТЫ: нормаль нельзя просто умножать на model при неравномерном масштабе (scale),
    // иначе она перестанет быть перпендикулярна поверхности! Поэтому берём обратную транспонированную матрицу.
    Normal = mat3(transpose(inverse(model))) * aNormal;
    // Главная формула графического конвейера (R3): v_clip = P * V * M * v_local
    gl_Position = projection * view * vec4(FragPos, 1.0);
}
