#version 330 core
// ============================================================================
// ВЕРШИННЫЙ ШЕЙДЕР НЕБА (sky.vert) — ядро Темы #13 (R1, R5)
// Выводит полноэкранный квадрат (2 треугольника от -1 до +1 в NDC).
// Глубина z = 0.9999 ставит небо на самую дальнюю плоскость, позади всей 3D-сцены.
// ============================================================================
layout (location = 0) in vec2 aPos;      // координаты угла экрана в NDC (-1..+1)
layout (location = 1) in vec2 aTexCoord; // UV-координаты экрана (0..1) для градиента и солнца

out vec2 UV; // передаём UV во фрагментный шейдер sky.frag

void main()
{
    UV = aTexCoord;
    gl_Position = vec4(aPos, 0.9999, 1.0);
}
